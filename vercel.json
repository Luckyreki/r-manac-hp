{
  "headers": [
    {
      "source": "/reserve",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/profile", "destination": "/profile/index.html" },
    { "source": "/music", "destination": "/music/index.html" },
    { "source": "/live", "destination": "/live/index.html" },
    { "source": "/sns", "destination": "/sns/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/reserve", "destination": "/reserve/index.html" }
  ]
}
